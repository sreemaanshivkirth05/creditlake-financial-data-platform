"execution_time": 0.11752009391784668, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.creditlake.dim_issuer", "compiled": true, "compiled_code": "select issuer_key, cik, name, ticker, sector, headquarters, valid_from\nfrom \"warehouse\".\"raw\".\"issuer_history\"\nwhere valid_to is null", "relation_name": "\"warehouse\".\"analytics\".\"dim_issuer\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T16:53:59.383030Z", "completed_at": "2026-09-17T16:53:59.385096Z"}, {"name": "execute", "started_at": "2026-09-17T16:53:59.385527Z", "completed_at": "2026-09-17T16:53:59.429283Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04830741882324219, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.creditlake.stg_canonical_facts", "compiled": true, "compiled_code": "-- Grain: issuer x metric x annual period end. Prefer the most recently\n-- filed evidence, then the documented taxonomy fallback order.\n-- Value is not part of the partition: conflicting revisions compete here,\n-- while all versions remain available in raw.facts.\nwith ranked as (\n    select *,\n      row_number() over (\n        partition by cik, metric, period_end\n        order by filed desc, alias_priority asc, accession desc,\n                 first_observed desc, fact_id\n      ) as version_rank\n    from \"warehouse\".\"analytics\".\"stg_annual_candidates\"\n)\nselect * exclude (version_rank)\nfrom ranked\nwhere version_rank = 1", "relation_name": "\"warehouse\".\"analytics\".\"stg_canonical_facts\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T16:53:59.365373Z", "completed_at": "2026-09-17T16:53:59.369290Z"}, {"name": "execute", "started_at": "2026-09-17T16:53:59.369656Z", "completed_at": "2026-09-17T16:53:59.441601Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.07741713523864746, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.creditlake.mart_filing_revisions", "compiled": true, "compiled_code": "-- Compare distinct monetary versions for one concept and economic period.\n-- Repeated unchanged comparative filings do not become revision alerts.\n-- A changed value can reflect a reclassification; it is not automatically\n-- a formal SEC restatement or evidence of an accounting problem.\nwith versions as (\n    select *, lag(value) over (\n        partition by cik, concept, unit, period_start, period_end\n        order by filed, accession, first_observed, fact_id\n    ) as previous_value\n    from \"warehouse\".\"analytics\".\"stg_annual_candidates\"\n)\nselect fact_id, cik, metric, concept, period_start, period_end,\n       accession, filed, value, previous_value,\n       value - previous_value as change_amount,\n       (value - previous_value) / nullif(abs(previous_value), 0) as relative_change,\n       source_sha, bronze_path\nfrom versions\nwhere previous_value is not null and value <> previous_value", "relation_name": "\"warehouse\".\"analytics\".\"mart_filing_revisions\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-17T16:53:59.435599Z", "completed_at": "2026-09-17T16:53:59.442711Z"}, {"name": "execute", "started_at": "2026-09-17T16:53:59.443727Z", "completed_at": "2026-09-17T16:53:59.461668Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.031175851821899414, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.creditlake.not_null_dim_issuer_cik.54078daa83", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect cik\nfrom \"warehouse\".\"analytics\".\"dim_issuer\"\nwhere cik is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile